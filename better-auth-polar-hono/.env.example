# The access token is hardcoded in auth.ts for this throwaway playground.
# This URL points to the Docker-based local Polar API (not Sandbox or production).
POLAR_SERVER_URL=http://127.0.0.1:8101

# Optional. Required only to exercise the checkout endpoint.
POLAR_PRODUCT_ID=

# Local app settings.
PORT=3002
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=throwaway-local-secret-at-least-32-characters
